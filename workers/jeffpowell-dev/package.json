{
  "name": "@jeffpowell/jeffpowell-dev",
  "description": "Personal portfolio website for Jeff Powell",
  "version": "1.0.0",
  "author": "Jeff Powell",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "webpack --mode=development --config webpack.development.config.js",
    "build-watch": "webpack --mode=development --config webpack.development.config.js --watch",
    "build-prod": "webpack --mode=production --config webpack.production.config.js",
    "dev": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "d3": "7.9.2",
    "htmx.org": "2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.5",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1",
    "wrangler": "^4.158.0"
  }
}
